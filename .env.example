# ─────────────────────────────────────────────────────────────────────────────
# CryptoLab — backend : modele de configuration
#
# Ce fichier est un MODELE, versionne dans git et jamais lu a l'execution.
# Il ne doit contenir aucune valeur reelle.
#
#   En local        : copiez-le en `.env` (ignore par git) et remplissez-le.
#   Sur Render      : ce fichier n'est pas deploye. Les valeurs se saisissent
#                     dans Dashboard > votre service > Environment.
#
# Il n'y a AUCUNE base de donnees a creer sur Render : Render ne propose pas de
# MongoDB manage. Les comptes vivent dans MongoDB Atlas, joint par MONGO_URI.
#
# Voir DEPLOYMENT.md pour la mise en ligne pas a pas.
# ─────────────────────────────────────────────────────────────────────────────


# ── Environnement ────────────────────────────────────────────────────────────
# "development" : replis silencieux et pratiques (comptes en memoire, secret
#                 ephemere) — l'API demarre sans aucune configuration.
# "production"  : toute configuration incomplete devient fatale au demarrage.
#                 Un refus net vaut mieux que des inscriptions ecrites en
#                 memoire et perdues au premier redemarrage.
CRYPTOLAB_ENV=development


# ── Authentification ─────────────────────────────────────────────────────────
# Secret de signature des jetons de session (JWT).
#
#   OBLIGATOIRE en production. Generez-le une fois, gardez-le stable :
#   le changer deconnecte tout le monde.
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CRYPTOLAB_JWT_SECRET=

# Duree de vie d'une session, en jours.
CRYPTOLAB_JWT_TTL_DAYS=7


# ── MongoDB ──────────────────────────────────────────────────────────────────
# URI de connexion Atlas, mot de passe compris :
#   mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
#   OBLIGATOIRE en production : c'est cette base qui porte les comptes.
#   En developpement, si elle est absente, les comptes sont gardes en memoire
#   du processus — pratique en local, perdus a l'arret du serveur.
#
# Pense-bete Atlas : Network Access doit autoriser 0.0.0.0/0. Les adresses
# sortantes de Render ne sont pas fixes sur le plan gratuit, et sans cette
# regle la connexion echoue alors que tout parait correct.
MONGO_URI=

# Base portant les comptes utilisateurs.
CRYPTOLAB_AUTH_DB=cryptolab_auth


# ── Statistiques d'usage anonymes (entierement optionnel) ────────────────────
# CryptoLab fonctionne sans. On n'y enregistre jamais de texte clair, jamais de
# cle, jamais de resultat : seulement le nom d'un algorithme, l'action demandee
# et une longueur, pour savoir quels chapitres servent le plus.
#
# Laisser sur "false" en cas de doute.
CRYPTOLAB_ENABLE_STATS=false

# Base des statistiques. Distincte de CRYPTOLAB_AUTH_DB, et sans effet tant que
# CRYPTOLAB_ENABLE_STATS vaut false.
DB_NAME=cryptolab


# ── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisees a appeler l'API, separees par des virgules, SANS barre
# oblique finale. En production, y mettre l'URL exacte du frontend Vercel :
# une origine absente d'ici fait echouer les appels du navigateur, alors que
# les memes requetes passent en curl.
CRYPTOLAB_ALLOWED_ORIGINS=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────────
# A COLLER DANS RENDER  (Environment > Add from .env)
#
# Remplacez les deux valeurs entre chevrons, puis collez le bloc entier.
# PYTHON_VERSION est propre a Render et n'a pas d'equivalent local.
#
#   PYTHON_VERSION=3.12
#   CRYPTOLAB_ENV=production
#   CRYPTOLAB_JWT_SECRET=<sortie de la commande secrets.token_urlsafe(64)>
#   CRYPTOLAB_JWT_TTL_DAYS=7
#   MONGO_URI=<votre URI Atlas complete>
#   CRYPTOLAB_AUTH_DB=cryptolab_auth
#   CRYPTOLAB_ENABLE_STATS=false
#   CRYPTOLAB_ALLOWED_ORIGINS=https://cryptolaboratory.vercel.app
#
# Verification, une fois le service demarre :
#   curl https://<votre-service>.onrender.com/health
# `accounts_backend` doit valoir "mongodb". S'il vaut "memory", la connexion
# Atlas a echoue et les inscriptions seront perdues au redemarrage.
# ─────────────────────────────────────────────────────────────────────────────
