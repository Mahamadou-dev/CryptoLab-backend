# --- Persistance (entierement optionnelle) ---
# CryptoLab fonctionne sans base de donnees. La persistance ne sert qu'a
# compter des statistiques d'usage ANONYMES : jamais de texte clair, jamais
# de cle, jamais de resultat.
#
# Laissez CRYPTOLAB_ENABLE_STATS a "false" (defaut) pour desactiver totalement.
CRYPTOLAB_ENABLE_STATS=false

# Utilise uniquement si CRYPTOLAB_ENABLE_STATS=true
MONGO_URI=mongodb://localhost:27017
DB_NAME=cryptolab

# --- CORS ---
# Origines autorisees, separees par des virgules.
CRYPTOLAB_ALLOWED_ORIGINS=http://localhost:3000
