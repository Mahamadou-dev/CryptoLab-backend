# Copiez ce fichier en `.env` et remplissez-le. `.env` est ignore par git :
# aucun secret reel ne doit apparaitre ici.

# --- Environnement ---
# "production" rend fatales les configurations incompletes (secret JWT absent,
# MongoDB injoignable) au lieu de replier silencieusement sur des valeurs de
# developpement.
CRYPTOLAB_ENV=development

# --- Authentification ---
# Secret de signature des jetons de session. OBLIGATOIRE en production.
# Generez-le avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CRYPTOLAB_JWT_SECRET=
CRYPTOLAB_JWT_TTL_DAYS=7

# --- MongoDB ---
# Sert a deux choses independantes :
#   1. les comptes utilisateurs (base CRYPTOLAB_AUTH_DB) — toujours actif ;
#   2. les statistiques anonymes (base DB_NAME) — desactive par defaut.
#
# Sans MONGO_URI et hors production, les comptes sont gardes en memoire du
# processus : pratique en local, perdu au redemarrage.
MONGO_URI=
CRYPTOLAB_AUTH_DB=cryptolab_auth

# --- Statistiques d'usage anonymes (entierement optionnel) ---
# CryptoLab fonctionne sans. On n'y enregistre jamais de texte clair, jamais de
# cle, jamais de resultat : seulement le nom d'un algorithme et une longueur.
CRYPTOLAB_ENABLE_STATS=false
DB_NAME=cryptolab

# --- CORS ---
# Origines autorisees, separees par des virgules.
CRYPTOLAB_ALLOWED_ORIGINS=http://localhost:3000
